# Copy to .env.local and fill in. See README.md for what each one does.

# --- Required ---
MONGODB_URI=
AUTH_EMAIL=
# Seeds the stored password on first login. After that the password lives as a
# salted hash in MongoDB and is changed from Settings, not here.
AUTH_PASSWORD=
# Long random string. Signs session cookies and public link tokens; changing it
# signs everyone out.
AUTH_SECRET=

# --- Scheduled run ---
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Gemini ---
AI_API_KEY=
# AI_MODEL=gemini-3.5-flash
# AI_TIMEOUT_MS=90000

# --- Optional fallback chain when Gemini's free tier is exhausted ---
# Each is an official free tier for that provider's own service — not a
# scraped/unofficial key source — tried in this order, only for plain
# generation calls, never for the grounded-search competitor/social-profile
# lookups. Leave all blank to disable; behavior is unchanged without them.
# Configure as many or as few as you like — each one just adds more daily
# headroom before a call can actually fail.

# 1) OpenRouter — broker for other providers' free tiers.
OPENROUTER_API_KEY=
# Free catalog rotates — check https://openrouter.ai/models?max_price=0 if
# this default has been retired. Buying $10 of credit once (not per month)
# permanently raises OpenRouter's own free-tier cap from 50 to 1,000 req/day.
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# 2) Groq — genuinely free (not trial-credit), fast, OpenAI-compatible.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 3) Cerebras — OpenAI-compatible. Note: a one-time $5 trial credit, not a
#    persistent free tier — will eventually stop working once it's spent.
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# 4) Cohere — persistent free trial key, but capped at 1,000 calls/MONTH
#    (not per day), so it's tried after the other free ones.
COHERE_API_KEY=
# COHERE_MODEL=command-a-plus-05-2026

# 5) OpenAI — real, official, but billed from the very first call, no free
#    tier at all. Absolute last resort, only reached once every free option
#    above has failed. Defaults to the cheapest current tier.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-nano

# --- Lead discovery (Google Places API, New) ---
GOOGLE_PLACES_API_KEY=

# --- Email via your Gmail (used when both are set; takes priority over Resend) ---
# Sends from your own Gmail and replies land in the same inbox. The password is
# a Google App Password (Google Account > Security > 2-Step Verification >
# App passwords), never your real Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# EMAIL_FROM_NAME=RMAST STUDIO

# --- Email (Resend, for a custom domain) ---
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_SECRET=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0

# --- Optional ---
# Reserved for a Hunter.io / Apollo.io contact lookup in lib/pipeline.ts
ENRICHMENT_API_KEY=
